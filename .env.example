# Copy this file to .env and fill in your own free-tier keys.
# .env is gitignored — never commit real keys.

# --- Gemini (chat brain + intent classification) -----------------------
# Free tier key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# "-latest" aliases auto-update to Google's current model, so this stays valid
# without edits. Free-tier speed varies a lot between models and over time —
# measured on one key minutes apart, flash answered in ~1-3s while flash-lite
# took 21-27s for the same prompt. If replies feel slow, try swapping these two.
GEMINI_MODEL=gemini-flash-latest
# Used automatically when the primary is congested (503 / high demand).
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# --- Groq (speech-to-text) -----------------------------------------------
# Free tier key: https://console.groq.com/keys
# Electron's Chromium can't use the browser's built-in SpeechRecognition
# (Google restricts it to real Chrome), so Nimbus records the mic and sends
# the audio here for transcription via Groq's free Whisper endpoint instead.
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- Voice (text-to-speech) -----------------------------------------------
# No key needed — uses Microsoft Edge's free neural voices. Swap in any voice
# name from https://speech.microsoft.com/portal/voicegallery (the "en-US-*Neural"
# style ids). Some natural-sounding options: en-US-AvaNeural, en-US-EmmaNeural,
# en-US-JennyNeural, en-US-AndrewNeural, en-US-BrianNeural, en-GB-SoniaNeural.
TTS_VOICE=en-US-AvaNeural

# --- OpenWeatherMap (weather) -------------------------------------------
# Free tier key: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# --- Stocks & crypto ---------------------------------------------------------
# No keys needed. Stocks use Yahoo Finance's public chart endpoint; crypto
# uses CoinGecko's public API. Both are free and unauthenticated.

# --- Tavily (general web search) -------------------------------------------
# Free tier: 1,000 searches/month, no credit card — https://app.tavily.com
# This is the general escape hatch: anything needing live info the model
# doesn't know (recent events, current facts) goes through here instead of
# needing its own dedicated API.
TAVILY_API_KEY=

# --- GNews (news headlines) — OPTIONAL, you probably don't need this --------
# News already works through TAVILY_API_KEY above (topic: news). Set a GNews
# key only if you want per-article thumbnail images: GNews returns an image
# per headline, whereas Tavily returns images for the topic as a whole.
# Free tier key: https://gnews.io/register
GNEWS_API_KEY=

# --- GitHub (trending repos) ----------------------------------------------
# No key required for public search endpoints (60 req/hr unauthenticated).
# Optional personal access token raises the limit to 5000 req/hr:
# https://github.com/settings/tokens (no scopes needed for public data)
GITHUB_TOKEN=

# --- Wake trigger -----------------------------------------------------------
# No key needed: Nimbus opens on a global hotkey (default Ctrl+Shift+Space)
# instead of a spoken wake word. Change it in config.json -> hotkey.accelerator.
